# =====================================================================
# Environment Variables — Example
# Copy to .env (local) or set in Railway dashboard (production)
# =====================================================================

# ─── App ─────────────────────────────────────────────────────────────
APP_NAME="Expense Memo Management System"
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=
APP_TIMEZONE=Asia/Bangkok

# Bind port (Railway sets this automatically — usually 8080)
PORT=8080

# ─── Database (Railway MySQL plugin auto-injects MYSQL*) ────────────
# When you add Railway MySQL plugin, these are set automatically:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# For external DB, use one of:
#   DATABASE_URL=mysql://user:pass@host:3306/dbname
# OR generic:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=expense_memo
DB_USER=root
DB_PASSWORD=

# ─── Auto-installer ─────────────────────────────────────────────────
# True = run schema + seed + create admin on first boot (idempotent)
AUTO_INSTALL=true

# ─── Default Admin User ─────────────────────────────────────────────
# Created on first boot. Leave password blank → random password generated + logged
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@loveandaman.com
ADMIN_PASSWORD=ChangeThis_Strong_Password!

# ─── Session ────────────────────────────────────────────────────────
SESSION_LIFETIME=28800
